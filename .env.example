# Hosted Groq transcription server (Proxy for Whisper & Llama)
EXPO_PUBLIC_TRANSCRIPTION_API_URL=https://voicepad-transcription.onrender.com

# Local alternatives for development
# Android emulator on the same computer as the server:
# EXPO_PUBLIC_TRANSCRIPTION_API_URL=http://10.0.2.2:8787
# Physical phone or iOS simulator on the same Wi-Fi as the server:
# EXPO_PUBLIC_TRANSCRIPTION_API_URL=http://192.168.1.20:8787

# Supabase public client configuration (safe to expose in the app for auth & RLS cloud storage)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side environment variables (set on Render / backend server .env)
# GROQ_API_KEY=gsk_...
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# REQUIRE_AUTH=false

