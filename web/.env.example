# Copy this to web/.env for local dev (`pnpm dev` inside /web), and set the same
# names as Environment Variables in the Vercel project settings for production.

# Where the transcription server lives. Falls back to the Render URL hardcoded in
# Home.tsx if unset, but set it explicitly so it's not silently relying on a fallback.
VITE_TRANSCRIPTION_API_URL=https://voicepad-transcription.onrender.com

# Optional. Without these, the app still works fully in guest mode; sign-in/sign-up
# and saved history just won't be available.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Umami analytics. Leave both blank to skip loading analytics entirely.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
