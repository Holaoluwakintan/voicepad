# Web Google AdSense (create a publisher account and use the ca-pub-* client ID)
VITE_ADSENSE_CLIENT=ca-pub-REPLACE_ME
# Optional AdSense for Platforms host ID
VITE_ADSENSE_HOST=
# Optional fixed display ad unit ID
VITE_ADSENSE_SLOT=

# Native Google AdMob (required for a production native build with ads)
ADMOB_ANDROID_APP_ID=ca-app-pub-REPLACE_ME~REPLACE_ME
ADMOB_IOS_APP_ID=ca-app-pub-REPLACE_ME~REPLACE_ME
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-REPLACE_ME/REPLACE_ME

# Public web SEO origin; use the canonical production domain, not a preview URL.
VITE_SITE_URL=https://voicepad.app
